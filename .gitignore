.env
# compiled output
/dist
/node_modules

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
# Local one-off scripts (DB inspection, backfills, etc.)
/scripts

# Manual SQL migrations and one-off backfill scripts are applied directly to
# the DB, not tracked in git.
*.sql
# ...except the manual migration SQLs, which are tracked so deploys can apply
# them in order (see the deploy runbook).
!prisma/migrations/manual/*.sql
