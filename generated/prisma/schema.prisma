generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int               @id @default(autoincrement()) @db.UnsignedInt
  email           String?           @unique(map: "email") @db.VarChar(255)
  name            String?           @db.VarChar(255)
  country         String?           @db.VarChar(2)
  password        String?           @db.VarChar(255)
  isAdmin         Boolean?
  createdAt       DateTime?         @default(now()) @db.Timestamp(0)
  updatedAt       DateTime?         @default(now()) @db.Timestamp(0)
  phone           String?           @db.VarChar(50)
  invitationList  Invitation[]
  InvitationOrder InvitationOrder[]
}

model Invitation {
  id                       Int                         @id @default(autoincrement()) @db.UnsignedInt
  templateNo               Int?                        @default(1)
  uniqueId                 String?                     @unique(map: "uniqueId") @db.VarChar(100)
  date                     DateTime?                   @db.Timestamp(0)
  userId                   Int?                        @db.UnsignedInt
  title                    String?                     @db.VarChar(60)
  description              String?                     @db.VarChar(160)
  pointColor               String?                     @default("#f79e9e") @db.VarChar(16)
  mainTextColor            String?                     @default("#000000") @db.VarChar(10)
  dressCodeGentleman       String?                     @db.Text
  dressCodeLady            String?                     @db.Text
  bgColor                  String?                     @default("#f7f7f7") @db.VarChar(10)
  musicKey                 String?                     @db.VarChar(255)
  musicFilename            String?                     @db.VarChar(255)
  musicFileKey             String?                     @db.VarChar(255)
  notice                   String?                     @db.Text
  brideFirstName           String?                     @db.VarChar(50)
  brideMiddleName          String?                     @db.VarChar(50)
  dressCodeMainColor       String?                     @default("#57372A") @db.VarChar(7)
  dressCodeSubColor        String?                     @default("#91604F") @db.VarChar(7)
  dressCodeThirdColor      String?                     @default("#D2947B") @db.VarChar(7)
  brideLastName            String?                     @db.VarChar(50)
  brideMomName             String?                     @db.VarChar(50)
  greetingTitle            String?                     @db.Text
  isGroomMomHidden         Boolean?
  isGroomDadHidden         Int?                        @db.TinyInt
  isBrideDadHidden         Int?                        @db.TinyInt
  isBrideMomHidden         Int?                        @db.TinyInt
  greetingContent          String?                     @db.Text
  brideDadName             String?                     @db.VarChar(50)
  bridePhone               String?                     @db.VarChar(50)
  groomFirstName           String?                     @db.VarChar(50)
  wishlistUrl              String?                     @db.VarChar(255)
  baseFont                 String?                     @db.VarChar(50)
  groomMiddleName          String?                     @db.VarChar(50)
  groomLastName            String?                     @db.VarChar(50)
  groomPhone               String?                     @db.VarChar(50)
  primarySponsor           String?                     @db.Text
  secondarySponsor         String?                     @db.Text
  bankAccount              String?                     @db.Text
  maidOfHonor              String?                     @db.Text
  groomsMen                String?                     @db.Text
  textColor                String?                     @db.VarChar(10)
  timezone                 String?                     @db.VarChar(50)
  rsvpTitle                String?                     @db.Text
  rsvpMaxPax               Int?
  rsvpDeadline             DateTime?                   @db.Timestamp(0)
  rsvpDeadlineDesc         String?                     @db.Text
  rsvpHasFood              Boolean?
  isRsvpPopup              Boolean?                    @default(false)
  hasRsvpDeadline          Boolean?                    @default(true)
  isPasswordProtected      Boolean?                    @default(false)
  universalPassword        String?                     @db.VarChar(100)
  // Access mode within Private: 'common' | 'specific'. Stored explicitly so a
  // Common invitation whose shared password hasn't been typed yet is not
  // mistaken for Specific (which is otherwise inferred from an empty password).
  accessMode               String?                     @db.VarChar(20)
  guestListEnabled         Boolean?                    @default(false)
  billingStatus            Invitation_billingStatus    @default(TRIAL)
  trialEndsAt              DateTime?                   @db.DateTime(0)
  currentPlanCode          Invitation_currentPlanCode?
  accessStartedAt          DateTime?                   @db.DateTime(0)
  accessEndsAt             DateTime?                   @db.DateTime(0)
  watermarkEnabled         Boolean                     @default(true)
  bestMan                  String?                     @db.Text
  bridesMaids              String?                     @db.Text
  wishlistText             String?                     @db.Text
  groomMomName             String?                     @db.VarChar(50)
  groomDadName             String?                     @db.VarChar(50)
  layoutOrder              Json?
  endingText               String?                     @db.Text
  ogImageKey               String?                     @db.VarChar(255)
  createdAt                DateTime?                   @default(now()) @db.Timestamp(0)
  updatedAt                DateTime?                   @default(now()) @db.Timestamp(0)
  bestManLabel             String?                     @db.VarChar(255)
  maidOfHonorLabel         String?                     @db.VarChar(255)
  groomsMenLabel           String?                     @db.VarChar(255)
  bridesMaidsLabel         String?                     @db.VarChar(255)
  sponsorColumns           Int                         @default(1) @db.UnsignedTinyInt
  secondarySponsorColumns  Int                         @default(1) @db.UnsignedTinyInt
  primarySponsorRight      String?                     @db.Text
  secondarySponsorRight    String?                     @db.Text
  onboardingCompletedAt    DateTime?                   @db.DateTime(0)
  openingEnabled           Boolean                     @default(false)
  openingText1             String?                     @db.VarChar(100)
  openingText2             String?                     @db.VarChar(100)
  openingText3             String?                     @db.VarChar(100)
  user                     User?                       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Invitation_ibfk_1")
  invitationCoverPhotoList InvitationCoverPhoto[]
  InvitationDressColor     InvitationDressColor[]
  invitationEntourageList  InvitationEntourage[]
  faqList                  InvitationFaq[]
  InvitationGuestGroup     InvitationGuestGroup[]
  InvitationOrder          InvitationOrder[]
  InvitationPaymentMethod  InvitationPaymentMethod[]
  photoList                InvitationPhoto[]
  placeList                InvitationPlace[]
  invitationRSVP           InvitationRSVP[]
  InvitationSeatingTable   InvitationSeatingTable[]

  @@index([userId], map: "userId")
  @@index([billingStatus], map: "idx_invitation_billing_status")
  @@index([trialEndsAt], map: "idx_invitation_trial_ends_at")
}

model InvitationPlace {
  id           Int                   @id @default(autoincrement()) @db.UnsignedInt
  invitationId Int?                  @db.UnsignedInt
  order        Int?                  @db.UnsignedInt
  placeId      Int?                  @db.UnsignedInt
  placeDetail  String?               @db.Text
  place        Place?                @relation(fields: [placeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "InvitationPlace_ibfk_1")
  invitation   Invitation?           @relation(fields: [invitationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "InvitationPlace_ibfk_2")
  timeList     InvitationPlaceTime[]

  @@index([invitationId], map: "invitationId")
  @@index([placeId], map: "placeId")
}

model Place {
  id                  Int               @id @default(autoincrement()) @db.UnsignedInt
  googlePlaceId       String?           @unique(map: "googlePlaceId") @db.VarChar(100)
  name                String?           @db.VarChar(255)
  address             String?           @db.VarChar(255)
  lat                 Float?            @db.Float
  lng                 Float?            @db.Float
  invitationPlaceList InvitationPlace[]
}

model InvitationPlaceTime {
  id                Int              @id @default(autoincrement()) @db.UnsignedInt
  invitationPlaceId Int?             @db.UnsignedInt
  time              DateTime?        @db.Time(0)
  name              String?          @db.VarChar(100)
  description       String?          @db.Text
  invitationPlace   InvitationPlace? @relation(fields: [invitationPlaceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "InvitationPlaceTime_ibfk_1")

  @@index([invitationPlaceId], map: "invitationPlaceId")
}

model InvitationPhoto {
  id           Int         @id @default(autoincrement()) @db.UnsignedInt
  invitationId String?     @db.VarChar(100)
  width        Int?
  height       Int?
  order        Int?        @db.UnsignedInt
  originalKey  String?     @db.VarChar(255)
  croppedKey   String?     @db.VarChar(255)
  cropX        Int?
  cropY        Int?
  cropZoom     Float?      @db.Float
  thumbKey     String?     @db.VarChar(255)
  thumbX       Int?
  thumbY       Int?
  thumbZoom    Float?      @db.Float
  Invitation   Invitation? @relation(fields: [invitationId], references: [uniqueId], onDelete: Cascade, map: "InvitationPhoto_ibfk_1")

  @@index([invitationId], map: "invitationId")
}

model InvitationCoverPhoto {
  id           Int         @id @default(autoincrement()) @db.UnsignedInt
  invitationId Int?        @db.UnsignedInt
  originalKey  String?     @db.VarChar(255)
  croppedKey   String?     @db.VarChar(255)
  type         String?     @db.VarChar(30)
  cropX        Float?      @db.Float
  cropY        Float?      @db.Float
  cropZoom     Float?      @db.Float
  width        Float?      @db.Float
  height       Float?      @db.Float
  createdAt    DateTime?   @default(now()) @db.Timestamp(0)
  updatedAt    DateTime?   @default(now()) @db.Timestamp(0)
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "InvitationCoverPhoto_ibfk_1")

  @@index([invitationId], map: "invitationId")
}

model InvitationRSVP {
  id                   Int                   @id @default(autoincrement()) @db.UnsignedInt
  invitationId         Int?                  @db.UnsignedInt
  guestGroupId         Int?                  @db.UnsignedInt
  side                 String?               @db.VarChar(10)
  name                 String?               @db.VarChar(100)
  guestNameList        String?               @db.Text
  email                String?               @db.VarChar(255)
  phone                String?               @db.VarChar(20)
  remark               String?               @db.Text
  food                 String?               @db.Text
  pax                  Int?
  attending            Boolean?
  createdAt            DateTime?             @default(now()) @db.Timestamp(0)
  invitation           Invitation?           @relation(fields: [invitationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "InvitationRSVP_ibfk_1")
  InvitationGuestGroup InvitationGuestGroup? @relation(fields: [guestGroupId], references: [id], onUpdate: NoAction, map: "fk_rsvp_guest_group")

  @@index([invitationId], map: "invitationId")
  @@index([guestGroupId], map: "idx_rsvp_guest_group")
}

model InvitationMusic {
  id    Int     @id @default(autoincrement()) @db.UnsignedInt
  s3Key String? @db.VarChar(255)
  name  String? @db.VarChar(20)
}

model InvitationView {
  id Int @id @default(autoincrement()) @db.UnsignedInt
}

model InvitationDressColor {
  id           Int         @id @default(autoincrement()) @db.UnsignedInt
  invitationId Int?        @db.UnsignedInt
  color        String?     @db.VarChar(10)
  order        Int?        @db.UnsignedInt
  type         String?     @db.VarChar(20)
  Invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade, map: "InvitationDressColor_ibfk_1")

  @@index([invitationId], map: "invitationId")
}

model InvitationGuest {
  id   Int     @id @default(autoincrement()) @db.UnsignedInt
  name String? @db.VarChar(50)
}

model InvitationFaq {
  id           Int         @id @default(autoincrement()) @db.UnsignedInt
  invitationId Int?        @db.UnsignedInt
  question     String?     @db.VarChar(255)
  answer       String?     @db.Text
  order        Int?        @db.UnsignedInt
  Invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade, map: "InvitationFaq_ibfk_1")

  @@index([invitationId], map: "invitationId")
}

model InvitationEntourage {
  id           Int        @id @default(autoincrement()) @db.UnsignedInt
  invitationId Int        @db.UnsignedInt
  label        String     @db.VarChar(100)
  name         String     @db.VarChar(255)
  order        Int        @default(0) @db.UnsignedInt
  createdAt    DateTime?  @default(now()) @db.Timestamp(0)
  updatedAt    DateTime?  @default(now()) @db.Timestamp(0)
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "InvitationEntourage_ibfk_1")

  @@index([invitationId], map: "idx_invitation_entourage_invitation_id")
  @@index([invitationId, order], map: "idx_invitation_entourage_invitation_order")
}

model Admin {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  name      String?   @db.VarChar(20)
  email     String?   @db.VarChar(255)
  password  String?   @db.VarChar(255)
  createdAt DateTime? @default(now()) @db.Timestamp(0)
  updatedAt DateTime? @default(now()) @db.Timestamp(0)
}

model EmailVerification {
  id           Int       @id @default(autoincrement())
  email        String    @db.VarChar(255)
  code         String    @db.VarChar(10)
  purpose      String    @db.VarChar(30)
  expiresAt    DateTime  @db.DateTime(0)
  verifiedAt   DateTime? @db.DateTime(0)
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now()) @db.DateTime(0)
  updatedAt    DateTime  @default(now()) @db.DateTime(0)

  @@index([email], map: "idx_email")
  @@index([email, purpose], map: "idx_email_purpose")
}

model InvitationOrder {
  id                Int                      @id @default(autoincrement()) @db.UnsignedInt
  invitationId      Int                      @db.UnsignedInt
  userId            Int                      @db.UnsignedInt
  pricePlanId       Int?                     @db.UnsignedInt
  orderNo           String                   @unique(map: "uk_invitation_order_order_no") @db.VarChar(40)
  planCode          InvitationOrder_planCode
  amountPhp         Int
  currency          String                   @default("PHP") @db.VarChar(3)
  durationDays      Int?
  status            InvitationOrder_status   @default(PENDING)
  paidAt            DateTime?                @db.DateTime(0)
  expiresAt         DateTime?                @db.DateTime(0)
  provider          String                   @default("paymongo") @db.VarChar(20)
  providerPaymentId String?                  @db.VarChar(100)
  providerEventId   String?                  @db.VarChar(100)
  rawPayload        Json?
  createdAt         DateTime                 @default(now()) @db.DateTime(0)
  updatedAt         DateTime                 @default(now()) @db.DateTime(0)
  Invitation        Invitation               @relation(fields: [invitationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_invitation_order_invitation")
  PricePlan         PricePlan?               @relation(fields: [pricePlanId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_invitation_order_price_plan")
  User              User                     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invitation_order_user")

  @@index([invitationId, status], map: "idx_order_invitation_status")
  @@index([provider, providerEventId], map: "idx_order_provider_event")
  @@index([provider, providerPaymentId], map: "idx_order_provider_payment")
  @@index([userId, createdAt], map: "idx_order_user_created_at")
  @@index([pricePlanId], map: "idx_order_price_plan")
}

model PricePlan {
  id              Int               @id @default(autoincrement()) @db.UnsignedInt
  code            String            @unique(map: "uk_price_plan_code") @db.VarChar(30)
  name            String            @db.VarChar(60)
  description     String?           @db.Text
  amountPhp       Int
  currency        String            @default("PHP") @db.VarChar(3)
  durationDays    Int?
  isActive        Boolean           @default(true)
  displayOrder    Int               @default(0) @db.UnsignedInt
  createdAt       DateTime          @default(now()) @db.DateTime(0)
  updatedAt       DateTime          @default(now()) @db.DateTime(0)
  InvitationOrder InvitationOrder[]

  @@index([isActive, displayOrder], map: "idx_price_plan_active_order")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  actorUserId Int?     @db.UnsignedInt
  action      String   @db.VarChar(100)
  targetType  String   @db.VarChar(50)
  targetId    String?  @db.VarChar(100)
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(255)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([action, createdAt], map: "idx_auditlog_action_created")
  @@index([actorUserId, createdAt], map: "idx_auditlog_actor_created")
  @@index([targetType, targetId, createdAt], map: "idx_auditlog_target_created")
}

model InvitationGuestGroup {
  id                       Int                              @id @default(autoincrement()) @db.UnsignedInt
  invitationId             Int                              @db.UnsignedInt
  name                     String                           @db.VarChar(100)
  password                 String?                          @db.VarChar(100)
  side                     InvitationGuestGroup_side?       @default(both)
  maxPax                   Int?                             @default(1)
  rsvpTitle                String?                          @db.VarChar(255)
  layoutOverride           Json?
  rsvpStatus               InvitationGuestGroup_rsvpStatus? @default(PENDING)
  rsvpAt                   DateTime?                        @db.DateTime(0)
  memo                     String?                          @db.Text
  order                    Int?                             @default(0) @db.UnsignedInt
  createdAt                DateTime?                        @default(now()) @db.DateTime(0)
  updatedAt                DateTime?                        @default(now()) @db.DateTime(0)
  Invitation               Invitation                       @relation(fields: [invitationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_guest_group_invitation")
  InvitationRSVP           InvitationRSVP[]
  InvitationSeatAssignment InvitationSeatAssignment?

  @@index([invitationId], map: "idx_guest_group_invitation")
  @@index([invitationId, password], map: "idx_guest_group_password")
}

model InvitationSeatAssignment {
  id                     Int                    @id @default(autoincrement()) @db.UnsignedInt
  seatingTableId         Int                    @db.UnsignedInt
  guestGroupId           Int                    @unique(map: "uk_guest_seat") @db.UnsignedInt
  seatNumber             Int?                   @db.UnsignedInt
  createdAt              DateTime?              @default(now()) @db.DateTime(0)
  InvitationGuestGroup   InvitationGuestGroup   @relation(fields: [guestGroupId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_seat_assignment_guest")
  InvitationSeatingTable InvitationSeatingTable @relation(fields: [seatingTableId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_seat_assignment_table")

  @@unique([seatingTableId, seatNumber], map: "uk_seat_assignment")
  @@index([seatingTableId], map: "idx_seat_assignment_table")
}

model InvitationSeatingTable {
  id                       Int                        @id @default(autoincrement()) @db.UnsignedInt
  invitationId             Int                        @db.UnsignedInt
  name                     String                     @db.VarChar(100)
  capacity                 Int                        @default(10) @db.UnsignedInt
  order                    Int?                       @default(0) @db.UnsignedInt
  createdAt                DateTime?                  @default(now()) @db.DateTime(0)
  updatedAt                DateTime?                  @default(now()) @db.DateTime(0)
  InvitationSeatAssignment InvitationSeatAssignment[]
  Invitation               Invitation                 @relation(fields: [invitationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_seating_table_invitation")

  @@index([invitationId], map: "idx_seating_table_invitation")
}

model InvitationPaymentMethod {
  id            Int                          @id @default(autoincrement()) @db.UnsignedInt
  invitationId  Int                          @db.UnsignedInt
  type          InvitationPaymentMethod_type
  customLabel   String?                      @db.VarChar(100)
  accountName   String?                      @db.VarChar(100)
  accountNumber String?                      @db.VarChar(100)
  qrImageKey    String?                      @db.VarChar(255)
  memo          String?                      @db.Text
  order         Int                          @default(0) @db.UnsignedInt
  createdAt     DateTime                     @default(now()) @db.DateTime(0)
  updatedAt     DateTime                     @default(now()) @db.DateTime(0)
  Invitation    Invitation                   @relation(fields: [invitationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payment_method_invitation")

  @@index([invitationId], map: "idx_payment_method_invitation")
  @@index([invitationId, order], map: "idx_payment_method_invitation_order")
}

enum InvitationOrder_status {
  PENDING
  PAID
  FAILED
  CANCELED
  EXPIRED
}

enum Invitation_billingStatus {
  TRIAL
  PENDING
  PAID
  EXPIRED
  CANCELED
}

enum InvitationOrder_planCode {
  STANDARD
  PREMIUM
}

enum Invitation_currentPlanCode {
  STANDARD
  PREMIUM
}

enum InvitationGuestGroup_side {
  groom
  bride
  both
}

enum InvitationGuestGroup_rsvpStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum InvitationPaymentMethod_type {
  GCASH
  MAYA
  AUB
  BANKCOM
  BDO
  BPI
  CHINABANK
  EASTWEST
  GOTYME
  METROBANK
  PBCOM
  PNB
  RCBC
  SEABANK
  SECURITY_BANK
  UNIONBANK
  OTHER
}
